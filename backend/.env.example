# Copy this file to .env and adjust as needed. All values shown are the defaults.

PROJECT_NAME=PackSure API
ENVIRONMENT=development

# SQLite by default (zero setup). For Postgres:
# DATABASE_URL=postgresql+psycopg2://packsure:packsure@localhost:5432/packsure
DATABASE_URL=sqlite:///./packsure.db

SECRET_KEY=dev-secret-key-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
